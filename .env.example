# ── Required ───────────────────────────────────────────────────────────────
# Postgres. Netlify Database (Data & Storage → Database) sets NETLIFY_DB_URL automatically.
DATABASE_URL=
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Encrypts Gmail refresh tokens and the service account key at rest: openssl rand -hex 32
ENCRYPTION_KEY=
# Shared secret between the scheduler and the background worker: openssl rand -hex 24
INTERNAL_API_SECRET=
# Public URL (Netlify sets URL automatically; set APP_URL only for a custom domain)
APP_URL=

# First administrator, created when no users exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Organisation
ORG_NAME=Gita Press, Gorakhpur
INTERNAL_DOMAINS=gitapress.org
ALERT_RECIPIENTS=

# ── Google (Sign in with Google, Gmail) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace domains allowed to sign in (comma separated)
GOOGLE_SSO_ALLOWED_DOMAINS=gitapress.org
# Role for people signing in for the first time: viewer | analyst | manager
GOOGLE_SSO_DEFAULT_ROLE=analyst
# Signing in also connects the person's own inbox (set false for sign-in only)
GOOGLE_SIGNIN_CONNECTS_MAILBOX=true
# Days of history read when an inbox is first connected
SIGNIN_BACKFILL_DAYS=90
# Allow sending replies through Gmail when a person presses Send
GMAIL_SEND_ENABLED=true
# Shared mailboxes: upload the service account key in Admin → Mailboxes (recommended),
# or put the JSON here if your host allows large environment variables
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── AI ─────────────────────────────────────────────────────────────────────
# gemini | anthropic (Claude) | openai | azure | heuristic
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude: set AI_PROVIDER=anthropic and the key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: Claude workspace ID, sent as the anthropic-workspace-id header
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Pace calls for free-tier quotas (6000 ≈ 10 requests a minute)
AI_MIN_INTERVAL_MS=

# ── Email delivery for alerts, reports and the morning digest (optional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESEND_API_KEY=
DIGEST_LOCAL_HOUR=7

# ── Chat alerts (optional) ─────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Demo data (keep false on the live site) ────────────────────────────────
DEMO_DATA_ENABLED=false
