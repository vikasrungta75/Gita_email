# Gita Mail settings. Copy this file to .env and fill it in.
# The same file works on the Windows desktop and on the Google Cloud server.

# ── Required ───────────────────────────────────────────────────────────────
# PostgreSQL on this machine (desktop: your own PostgreSQL; cloud: the PostgreSQL on the VM)
DATABASE_URL=postgres://gitamail:CHANGE_ME@localhost:5432/gitamail
# 32+ random characters each. Create them with:  npm run keys
JWT_SECRET=
# Encrypts Gmail connections and the service account key. Never change it after mailboxes are connected.
ENCRYPTION_KEY=
# Optional: lets a scheduler call /api/system/run
INTERNAL_API_SECRET=

# Where people open Gita Mail
#   desktop: http://localhost:8888
#   cloud:   https://mail.gitapress.org   (your domain, served by nginx)
APP_URL=http://localhost:8888
PORT=8888
# desktop: 127.0.0.1 (only this computer) or 0.0.0.0 (other computers on the office network)
# cloud:   127.0.0.1 (nginx on the same VM forwards to it)
HOST=127.0.0.1
# local | cloud  (labels and defaults only; behaviour is the same)
APP_ROLE=local
# Set to false on a copy that should not read mail or run the send queue (e.g. a test copy)
WORKER=true

# First administrator, created when no users exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Organisation
ORG_NAME=Gita Press, Gorakhpur
INTERNAL_DOMAINS=gitapress.org
ALERT_RECIPIENTS=

# ── Google (Sign in with Google, Gmail) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace domains allowed to sign in (comma separated)
GOOGLE_SSO_ALLOWED_DOMAINS=gitapress.org
# Role for people signing in for the first time: viewer | analyst | manager
GOOGLE_SSO_DEFAULT_ROLE=analyst
GOOGLE_SIGNIN_CONNECTS_MAILBOX=true
# Days of history read when an inbox is first connected (30, 60 or 90; also set in Settings)
SIGNIN_BACKFILL_DAYS=90
# Allow sending replies through Gmail when a person presses Send (nothing is ever sent automatically)
GMAIL_SEND_ENABLED=true
# Shared mailboxes: upload the service account key in Settings → Mailboxes (recommended)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── AI (optional: without a key the rules engine drafts everything) ────────
# anthropic (Claude) | gemini | openai | azure | heuristic
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MIN_INTERVAL_MS=

# ── Email delivery for alerts and reports (optional) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESEND_API_KEY=

# ── Backups (cloud): nightly pg_dump is copied to this Cloud Storage bucket ─
BACKUP_BUCKET=
BACKUP_KEEP_DAYS=30

# Demo data (keep false on the live site)
DEMO_DATA_ENABLED=false
