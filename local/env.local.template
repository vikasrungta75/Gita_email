# ═══════════════════════════════════════════════════════════════════════════
# Gita Mail, local edition: settings file
# 1. Copy this file into the Gita Mail folder and name it exactly:  .env
# 2. Fill every line marked REQUIRED. Values marked "from Netlify" must be copied
#    from the Gita Mail Netlify site (Site configuration → Environment variables).
# 3. Run:  npm run local:check     (it tells you if anything is missing or wrong)
# Never share this file: it contains passwords and keys.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database on this computer (REQUIRED) ────────────────────────────────────
# Your PostgreSQL user, its password, the port (normally 5432) and a database
# name. "npm run local:check" creates the database if it does not exist yet.
# If the password contains @ : / or #, replace them: @ → %40, : → %3A, / → %2F, # → %23
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/gitamail

# ── Address and port ────────────────────────────────────────────────────────
APP_URL=http://localhost:8888
PORT=8888

# ── Security keys (REQUIRED, from Netlify) ──────────────────────────────────
# Copy these three exactly from Netlify. ENCRYPTION_KEY unlocks the stored Gmail
# connections and the service-account key; a different value means reconnecting them.
# Starting fresh with no cloud data? Make new ones: run  npm run local:keys
JWT_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_SECRET=

# ── First administrator (REQUIRED) ──────────────────────────────────────────
# Created automatically on first start if no users exist. Use a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Organisation ────────────────────────────────────────────────────────────
ORG_NAME=Gita Press, Gorakhpur
INTERNAL_DOMAINS=gitapress.org
# Who receives alert emails (comma separated); blank = ADMIN_EMAIL
ALERT_RECIPIENTS=

# ── Google: sign-in and Gmail (from Netlify) ────────────────────────────────
# Also add http://localhost:8888 and http://localhost:8888/api/auth/google/callback
# to the OAuth client in Google Cloud Console (see the guide, step 5).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SSO_ALLOWED_DOMAINS=gitapress.org
GOOGLE_SSO_DEFAULT_ROLE=analyst
GOOGLE_SIGNIN_CONNECTS_MAILBOX=true
SIGNIN_BACKFILL_DAYS=90
GMAIL_SEND_ENABLED=true
# Shared mailboxes: leave blank if the service-account key was uploaded in
# Admin → Mailboxes (it is stored in the database). Otherwise paste the JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── AI (REQUIRED for good analysis and drafts, from Netlify) ────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: Claude workspace ID, sent as the anthropic-workspace-id header
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional alternative
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MIN_INTERVAL_MS=

# ── Sending alert and report emails (optional, from Netlify) ────────────────
# Fill either SMTP or RESEND, or leave blank (alerts then show in the app only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESEND_API_KEY=
DIGEST_LOCAL_HOUR=7

# ── Chat alerts (optional) ──────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Demo data (keep false) ──────────────────────────────────────────────────
DEMO_DATA_ENABLED=false
